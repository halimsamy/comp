{
  "name": "@trycompai/jobs",
  "version": "0.0.1",
  "private": true,
  "description": "trigger.dev-compatible background jobs on pg-boss (Postgres)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "bun": "./src/worker/index.ts",
      "import": "./dist/worker/index.mjs",
      "require": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker/index.ts --format cjs,esm --clean",
    "check-ids": "bun scripts/check-task-ids.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trycompai/db": "workspace:*",
    "pg-boss": "12.38.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
