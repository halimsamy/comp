model Attachment {
  id         String               @id @default(dbgenerated("generate_prefixed_cuid('att'::text)"))
  name       String
  url        String
  type       AttachmentType
  entityId   String
  entityType AttachmentEntityType

  // Dates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comment        Comment?     @relation(fields: [commentId], references: [id])
  commentId      String?
  vendorDocument VendorDocument?

  // Evidence validity: a file is current from validFrom until validUntil, then "needs update".
  // Framework exports take only files valid inside the audit period.
  validFrom    DateTime?
  validUntil   DateTime?
  uploadedById String? // User id of the uploader

  @@index([entityId, entityType])
}

enum AttachmentEntityType {
  task
  vendor
  risk
  comment
  trust_nda
  task_item
  background_check
  employment_onboard
  employment_offboard
  offboarding_checklist
  audit_request
  vulnerability_scan
  vulnerability
  access_review_item
  training_record
}

enum AttachmentType {
  image
  video
  audio
  document
  other
}
