/// System inventory (ISO 27001 A.5.9, A.8.1; PCI DSS 12.5.1, 12.5.2): one row per
/// cloud resource, repository, device or manually added item. Integration and
/// device rows are upserted by the asset sync; the attributes below the source
/// fields are set by people and never overwritten by a sync.
model Asset {
  id             String       @id @default(dbgenerated("generate_prefixed_cuid('ast'::text)"))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  source       AssetSource
  connectionId String?
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  providerSlug String?
  /// Provider-native id (ARN, repo full name), the device id, or a generated id for manual rows.
  externalId   String
  resourceType String?
  name         String

  type               AssetType
  environment        AssetEnvironment        @default(unknown)
  cdeScope           AssetCdeScope           @default(unassessed)
  dataClassification AssetDataClassification @default(unclassified)
  ownerId            String?
  owner              Member?                 @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  description        String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Set when the source no longer reports the asset, or a person retires a manual one.
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vulnerabilities IntegrationPlatformFinding[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, archivedAt])
  @@index([connectionId])
  @@index([ownerId])
}

enum AssetSource {
  integration
  device
  manual
}

enum AssetType {
  computer
  compute
  container
  serverless
  database
  storage
  network
  repository
  key_secret
  messaging
  cloud_account
  application
  other
}

enum AssetEnvironment {
  production
  staging
  development
  test
  unknown
}

/// PCI DSS 12.5.2 scope: stores/processes/transmits CHD, can affect the CDE, or out of scope.
enum AssetCdeScope {
  unassessed
  in_scope
  connected
  out_of_scope
}

enum AssetDataClassification {
  unclassified
  public
  internal
  confidential
  restricted
}

enum VulnerabilitySource {
  integration
  asv_scan
  pentest
  manual
}
