// Periodic risk review event (ISO 27001 Clause 8.2: risk assessments are
// performed at planned intervals). Append-only like RiskAcceptance: the API
// exposes no update/delete. `snapshot` freezes the register as reviewed
// (levels, owners, treatment, open actions) so the history survives later edits.
model RiskReview {
  id String @id @default(dbgenerated("generate_prefixed_cuid('rskrv'::text)"))

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Who signed the review off. Name frozen so the record survives member removal.
  reviewedById   String?
  reviewedBy     Member? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByName String

  // ISO 27001 8.2: reviews run at planned intervals or on significant change.
  trigger       RiskReviewTrigger @default(scheduled)
  notes         String?
  snapshot      Json
  nextReviewDue DateTime

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

enum RiskReviewTrigger {
  scheduled
  significant_change
}
