# Required
AUTH_SECRET="" # openssl rand -base64 32
DATABASE_URL="" # Format: "postgresql://postgres:pass@127.0.0.1:5432/comp"
SENDGRID_API_KEY="" # SendGrid API key (Mail Send permission), used by the API email worker
EMAIL_FROM_MARKETING=""
EMAIL_FROM_SYSTEM=""
EMAIL_FROM_DEFAULT=""
EMAIL_FROM_TRUST_PORTAL="" # Sender for Trust Portal access/NDA emails (falls back to EMAIL_FROM_SYSTEM)
EMAIL_TO_TEST=""
EMAIL_REPLY_TO_MARKETING=""
REVALIDATION_SECRET="" # openssl rand -base64 32
NEXT_PUBLIC_PORTAL_URL="http://localhost:3002" # The employee portal uses port 3002 by default

# Recommended
# Store attachemnts in any S3 compatible bucket, we use AWS
APP_AWS_ACCESS_KEY_ID="" # AWS Access Key ID
APP_AWS_SECRET_ACCESS_KEY="" # AWS Secret Access Key
APP_AWS_REGION="" # AWS Region
APP_AWS_BUCKET_NAME="" # AWS Bucket Name
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=""  # AWS, Required for Security Questionnaire feature
APP_AWS_KNOWLEDGE_BASE_BUCKET="" # AWS Required for the Knowledge Base feature in Security Questionnaire
# Background jobs run on pg-boss in DATABASE_URL (`bun run worker` in apps/api and apps/app).
# JOBS_DATABASE_URL="" # Optional: separate Postgres for job queues

ANTHROPIC_API_KEY="" # Claude: AI Chat + Auto Generated Policies, Risks + Vendors
VOYAGE_API_KEY="" # Voyage AI embeddings (vector search)
FIRECRAWL_API_KEY="" # For research, self-host or use cloud-version @ https://firecrawl.dev

# Feature flags forced on for everyone (comma-separated); use when PostHog is not set up
FORCE_ENABLED_FEATURE_FLAGS="ai-vendor-questionnaire,is-ai-policy-assistant-enabled,is-isms-enabled,is-timeline-enabled,is-trust-nda-enabled,is-web-automations-enabled"

TRUST_APP_URL="http://localhost:3008" # Trust portal public site for NDA signing and access requests

AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://*.trycomp.ai,http://localhost:3002
COMP_EXTENSION_TRUSTED_ORIGINS=chrome-extension://<extension-id>
